{
  "name": "dsh-model-assistant",
  "version": "0.1.0-alpha.2",
  "description": "ModelPilot — a standalone DSH model-configuration assistant plugin: capability facts, user profiles, and field-level projection onto DSH settings with revision-fenced writes.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "prepublishOnly": "node scripts/build-client.mjs",
    "test": "node --test test/**/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.2.2-0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "modelpilot",
    "model-assistant",
    "model-configuration",
    "reasoning-efforts",
    "llm-pi-ai",
    "llm-deepseek"
  ]
}
