{
  "name": "dsh-model-assistant",
  "version": "0.1.0-alpha.3",
  "description": "ModelPilot —— 独立的 DSH 模型配置助手插件：能力事实、用户档案，以及字段级投影到 DSH 设置，写入带版本围栏。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "prepublishOnly": "node scripts/build-client.mjs",
    "test": "node --test test/**/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.2.3-0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.0-rc.2 <0.2.3-0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "engines": {
    "node": ">=24.9.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "modelpilot",
    "model-assistant",
    "model-configuration",
    "reasoning-efforts",
    "llm-pi-ai",
    "llm-deepseek"
  ]
}
